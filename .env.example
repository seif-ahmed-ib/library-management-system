APP_NAME=Library Management System API
API_V1_PREFIX=/api/v1

# Generate a unique value with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-this-with-a-unique-64-character-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# PostgreSQL for the complete project stack.
DATABASE_URL=postgresql+psycopg://library_user:library_password@localhost:5432/library_db
# For a zero-setup local database instead, use:
# DATABASE_URL=sqlite:///./library.db

MAX_BORROWED_BOOKS=3

REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=120

LOG_LEVEL=INFO
LOG_FILE=logs/library-api.log
